<!--
  === File overview ===
  This file implements the WPF application shell and emulator-facing user interface.
  Comments below describe responsibilities and boundaries; runtime behavior is unchanged.
-->

<Window x:Class="ZedExEss.BasicProgramDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BASIC Program"
        Width="780"
        Height="560"
        MinWidth="520"
        MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Top"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,8">
            <Button Content="Inject"
                    Width="90"
                    IsDefault="True"
                    Click="OnInject" />
            <Button Content="Reload From Memory"
                    Width="140"
                    Margin="8,0,0,0"
                    Click="OnReload" />
            <Button Content="Close"
                    Width="90"
                    IsCancel="True"
                    Margin="8,0,0,0" />
        </StackPanel>
        <Grid>
            <TextBox x:Name="BasicInput"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     FontFamily="Consolas"
                     FontSize="14"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     TextChanged="OnBasicTextChanged" />
        </Grid>
    </DockPanel>
</Window>
