<!--
  === File overview ===
  This file implements the WPF application shell and emulator-facing user interface.
  Comments below describe responsibilities and boundaries; runtime behavior is unchanged.
-->

<Window x:Class="ZedExEss.AudioOscilloscopeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio Oscilloscope" Height="520" Width="860"
        MinHeight="360" MinWidth="520"
        Background="#101010"
        UseLayoutRounding="True">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="Beeper" Foreground="#F0F0F0" FontWeight="SemiBold" Margin="4,0,0,0" />
            <Border Margin="0,22,0,0" BorderBrush="#303030" BorderThickness="1" Background="#050505">
                <Canvas x:Name="BeeperCanvas" ClipToBounds="True">
                    <Line x:Name="BeeperCenterLine" Stroke="#202020" StrokeThickness="1" />
                    <Polyline x:Name="BeeperWave" Stroke="#F5E663" StrokeThickness="1.4" />
                </Canvas>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <TextBlock Text="AY A" Foreground="#F0F0F0" FontWeight="SemiBold" Margin="4,0,0,0" />
            <Border Margin="0,22,0,0" BorderBrush="#303030" BorderThickness="1" Background="#050505">
                <Canvas x:Name="AyACanvas" ClipToBounds="True">
                    <Line x:Name="AyACenterLine" Stroke="#202020" StrokeThickness="1" />
                    <Polyline x:Name="AyAWave" Stroke="#55D6BE" StrokeThickness="1.4" />
                </Canvas>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <TextBlock Text="AY B" Foreground="#F0F0F0" FontWeight="SemiBold" Margin="4,0,0,0" />
            <Border Margin="0,22,0,0" BorderBrush="#303030" BorderThickness="1" Background="#050505">
                <Canvas x:Name="AyBCanvas" ClipToBounds="True">
                    <Line x:Name="AyBCenterLine" Stroke="#202020" StrokeThickness="1" />
                    <Polyline x:Name="AyBWave" Stroke="#7AA2FF" StrokeThickness="1.4" />
                </Canvas>
            </Border>
        </Grid>

        <Grid Grid.Row="6">
            <TextBlock Text="AY C" Foreground="#F0F0F0" FontWeight="SemiBold" Margin="4,0,0,0" />
            <Border Margin="0,22,0,0" BorderBrush="#303030" BorderThickness="1" Background="#050505">
                <Canvas x:Name="AyCCanvas" ClipToBounds="True">
                    <Line x:Name="AyCCenterLine" Stroke="#202020" StrokeThickness="1" />
                    <Polyline x:Name="AyCWave" Stroke="#FF77C8" StrokeThickness="1.4" />
                </Canvas>
            </Border>
        </Grid>
    </Grid>
</Window>
