        <ToolBar x:Name="QuickAccessToolBar" DockPanel.Dock="Top" Background="#202020" Padding="2">
            <Button x:Name="QuickOpenButton" Style="{StaticResource QuickIconButtonStyle}" ToolTip="Open file" Click="OnOpenFile">
                <Viewbox Stretch="Uniform">
                    <Canvas Width="24" Height="24">
                        <Path Data="M3,7 L9,7 L11,9 L21,9 L21,19 L3,19 Z M3,11 L21,11" Stroke="White" StrokeThickness="2" StrokeLineJoin="Round" Fill="Transparent" />
                    </Canvas>
                </Viewbox>
            </Button>
            <Button x:Name="QuickResetButton" Style="{StaticResource QuickIconButtonStyle}" ToolTip="Hard reset" Click="OnResetMachine">
                <Viewbox Stretch="Uniform">
                    <Canvas Width="24" Height="24">
                        <Path Data="M4,4 L4,10 L10,10 M5,12 A7,7 0 1 0 7,7" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                    </Canvas>
                </Viewbox>
            </Button>
            <Button x:Name="QuickPausePlayButton" Style="{StaticResource QuickIconButtonStyle}" ToolTip="Pause emulation" Click="OnQuickPausePlay">
                <Grid>
                    <Viewbox x:Name="QuickPauseIcon" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Rectangle Canvas.Left="6" Canvas.Top="4" Width="4" Height="16" Fill="White" />
                            <Rectangle Canvas.Left="14" Canvas.Top="4" Width="4" Height="16" Fill="White" />
                        </Canvas>
                    </Viewbox>
                    <Viewbox x:Name="QuickPlayIcon" Stretch="Uniform" Visibility="Collapsed">
                        <Canvas Width="24" Height="24">
                            <Polygon Points="7,4 19,12 7,20" Fill="White" />
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Button>
            <Button x:Name="QuickFastForwardButton" Style="{StaticResource QuickIconButtonStyle}" ToolTip="Fast-forward (`)" Click="OnQuickFastForward">
                <Viewbox Stretch="Uniform">
                    <Canvas Width="24" Height="24">
                        <Polygon Points="3,5 12,12 3,19" Fill="White" />
                        <Polygon Points="11,5 20,12 11,19" Fill="White" />
                    </Canvas>
                </Viewbox>
            </Button>
            <Button x:Name="QuickNmiButton" Style="{StaticResource QuickIconButtonStyle}" ToolTip="Trigger NMI" Click="OnQuickNmi">
                <Viewbox Stretch="Uniform">
                    <Canvas Width="24" Height="24">
                        <Polygon Points="13,2 5,13 11,13 9,22 19,10 13,10" Stroke="White" StrokeThickness="1.6" StrokeLineJoin="Round" Fill="Transparent" />
                    </Canvas>
                </Viewbox>
            </Button>
            <Separator />
            <Button x:Name="QuickTapeBrowserButton" Style="{StaticResource QuickIconButtonStyle}" ToolTip="Hide tape browser" Click="OnToggleTapeBrowser">
                <Grid>
                    <Viewbox x:Name="QuickTapeHideIcon" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Rectangle Canvas.Left="3" Canvas.Top="5" Width="18" Height="14" Stroke="White" StrokeThickness="2" Fill="Transparent" />
                            <Line X1="15" Y1="5" X2="15" Y2="19" Stroke="White" StrokeThickness="2" />
                            <Path Data="M11,9 L7,12 L11,15" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                        </Canvas>
                    </Viewbox>
                    <Viewbox x:Name="QuickTapeShowIcon" Stretch="Uniform" Visibility="Collapsed">
                        <Canvas Width="24" Height="24">
                            <Rectangle Canvas.Left="3" Canvas.Top="5" Width="18" Height="14" Stroke="White" StrokeThickness="2" Fill="Transparent" />
                            <Line X1="15" Y1="5" X2="15" Y2="19" Stroke="White" StrokeThickness="2" />
                            <Path Data="M17,9 L21,12 L17,15" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Button>
        </ToolBar>
        <Border x:Name="StatusBarPanel" DockPanel.Dock="Bottom" Background="#181818" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusText" Foreground="#E8E8E8" Text="Starting emulator..." TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="ReplayStatusText" Foreground="#FFD79B" Margin="12,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" x:Name="TapeStatusText" Foreground="#B8D8FF" Margin="12,0,0,0" Text="Tape: none" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Grid x:Name="MainContentGrid" Background="Black">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TapeBrowserColumn" Width="300" />
            </Grid.ColumnDefinitions>
            <Border x:Name="ScreenHost" Background="Black" Margin="6" Grid.Column="0"
                    SnapsToDevicePixels="True">
                <Image x:Name="ScreenImage"
                       Stretch="Fill"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       SnapsToDevicePixels="True" />
            </Border>
            <Border x:Name="TapeBrowserPanel" Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1" Padding="8" Margin="6" Grid.Column="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="DiskActivityLight" Width="10" Height="10" Fill="#202020" Stroke="#555555" StrokeThickness="1" Margin="0,3,6,0" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="DiskStatusText" Foreground="White" FontWeight="SemiBold" Text="Disk: (none)" TextWrapping="Wrap" />
                            <TextBlock x:Name="MicrodriveStatusText" Foreground="#B8D7FF" Text="Microdrive: disabled" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <TabControl Grid.Row="1" Grid.RowSpan="6" Background="#141414" BorderBrush="#2A2A2A">
                        <TabItem Header="Tape">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" x:Name="TapeFileText" Foreground="White" FontWeight="SemiBold" Text="Tape: (none)" Margin="0,0,0,6" TextWrapping="Wrap" />
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button x:Name="TapePlayButton" Content="Play" Width="56" Margin="0,0,6,0" Click="OnTapePlay" />
                                    <Button x:Name="TapeStopButton" Content="Stop" Width="56" Margin="0,0,6,0" Click="OnTapeStop" />
                                    <Button x:Name="TapeRewindButton" Content="Rewind" Width="66" Margin="0,0,6,0" Click="OnTapeRewind" />
                                    <Button x:Name="TapeEjectButton" Content="Eject" Width="56" Click="OnTapeEject" />
                                </StackPanel>
                                <ProgressBar Grid.Row="2" x:Name="TapeBlockProgress" Minimum="0" Maximum="1" Height="14" />
                                <TextBlock Grid.Row="3" x:Name="TapeBlockText" Foreground="White" Margin="0,4,0,6" Text="No tape loaded" TextWrapping="Wrap" />
                                <ListView Grid.Row="5" x:Name="TapeBlocksList" MouseDoubleClick="OnTapeBlockDoubleClick"
                                          Background="#111" Foreground="White" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="#" Width="38" DisplayMemberBinding="{Binding DisplayIndex}" />
                                            <GridViewColumn Header="Type" Width="110" DisplayMemberBinding="{Binding Type}" />
                                            <GridViewColumn Header="Len" Width="50" DisplayMemberBinding="{Binding Length}" />
                                            <GridViewColumn Header="Name" Width="140" DisplayMemberBinding="{Binding FileName}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </TabItem>
                        <TabItem Header="+3 Disks">
                            <StackPanel Margin="6">
                                <GroupBox Header="Drive A" Foreground="White" BorderBrush="#444" Margin="0,0,0,10">
                                    <StackPanel Margin="4">
                                        <TextBlock x:Name="Plus3APathText" Foreground="White" Text="(none)" TextWrapping="Wrap" Margin="0,0,0,6" />
                                        <WrapPanel>
                                            <Button x:Name="Plus3AInsertButton" Content="Insert..." Margin="0,0,5,5" Padding="6,2" Click="OnDiskInsert" />
                                            <Button x:Name="Plus3ANewButton" Content="New..." Margin="0,0,5,5" Padding="6,2" Click="OnDiskNewBlank" />
                                            <Button x:Name="Plus3ASaveButton" Content="Save As..." Margin="0,0,5,5" Padding="6,2" Click="OnDiskSaveAs" />
                                            <Button x:Name="Plus3AEjectButton" Content="Eject" Margin="0,0,5,5" Padding="6,2" Click="OnDiskEject" />
                                        </WrapPanel>
                                        <CheckBox x:Name="Plus3AWriteProtectCheck" Foreground="White" Content="Write protected" Click="OnDiskWriteProtectToggle" />
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="Drive B" Foreground="White" BorderBrush="#444">
                                    <StackPanel Margin="4">
                                        <TextBlock x:Name="Plus3BPathText" Foreground="White" Text="(none)" TextWrapping="Wrap" Margin="0,0,0,6" />
                                        <WrapPanel>
                                            <Button x:Name="Plus3BInsertButton" Content="Insert..." Margin="0,0,5,5" Padding="6,2" Click="OnDiskBInsert" />
                                            <Button x:Name="Plus3BNewButton" Content="New..." Margin="0,0,5,5" Padding="6,2" Click="OnDiskBNewBlank" />
                                            <Button x:Name="Plus3BSaveButton" Content="Save As..." Margin="0,0,5,5" Padding="6,2" Click="OnDiskBSaveAs" />
                                            <Button x:Name="Plus3BEjectButton" Content="Eject" Margin="0,0,5,5" Padding="6,2" Click="OnDiskBEject" />
                                        </WrapPanel>
                                        <CheckBox x:Name="Plus3BWriteProtectCheck" Foreground="White" Content="Write protected" Click="OnDiskBWriteProtectToggle" />
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Microdrive">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="MicrodriveTabPanel" Margin="6" />
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Beta Disks">
                            <StackPanel Margin="6">
                                <GroupBox Header="Drive A" Foreground="White" BorderBrush="#444" Margin="0,0,0,10">
                                    <StackPanel Margin="4">
                                        <TextBlock x:Name="BetaAPathText" Foreground="White" Text="(none)" TextWrapping="Wrap" Margin="0,0,0,6" />
                                        <WrapPanel>
                                            <Button x:Name="BetaAInsertButton" Content="Insert..." Margin="0,0,5,5" Padding="6,2" Click="OnBetaDiskInsert" />
                                            <Button x:Name="BetaASaveButton" Content="Save As..." Margin="0,0,5,5" Padding="6,2" Click="OnBetaDiskSaveAs" />
                                            <Button x:Name="BetaAEjectButton" Content="Eject" Margin="0,0,5,5" Padding="6,2" Click="OnBetaDiskEject" />
                                        </WrapPanel>
                                        <CheckBox x:Name="BetaAWriteProtectCheck" Foreground="White" Content="Write protected" Click="OnBetaDiskWriteProtectToggle" />
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="Drive B" Foreground="White" BorderBrush="#444">
                                    <StackPanel Margin="4">
                                        <TextBlock x:Name="BetaBPathText" Foreground="White" Text="(none)" TextWrapping="Wrap" Margin="0,0,0,6" />
                                        <WrapPanel>
                                            <Button x:Name="BetaBInsertButton" Content="Insert..." Margin="0,0,5,5" Padding="6,2" Click="OnBetaDiskBInsert" />
                                            <Button x:Name="BetaBSaveButton" Content="Save As..." Margin="0,0,5,5" Padding="6,2" Click="OnBetaDiskBSaveAs" />
                                            <Button x:Name="BetaBEjectButton" Content="Eject" Margin="0,0,5,5" Padding="6,2" Click="OnBetaDiskBEject" />
                                        </WrapPanel>
                                        <CheckBox x:Name="BetaBWriteProtectCheck" Foreground="White" Content="Write protected" Click="OnBetaDiskBWriteProtectToggle" />
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
