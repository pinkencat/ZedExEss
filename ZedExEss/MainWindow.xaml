                    <MenuItem Header="_Save State As..." Click="OnSaveZxNextState" />
                    <MenuItem Header="_Load State..." Click="OnLoadZxNextState" />
                    <Separator />
                    <MenuItem x:Name="ZxNextStateSaveMenu" Header="Sa_ve Slot" />
                    <MenuItem x:Name="ZxNextStateLoadMenu" Header="Load S_lot" />
                </MenuItem>
                <MenuItem x:Name="TurboMenu" Header="_Turbo Mode" IsCheckable="True" Click="OnTurboModeToggle" />
                <MenuItem x:Name="FastForwardMenu" Header="_Fast Forward" InputGestureText="`" IsCheckable="True" Click="OnFastForwardToggle" />
                <MenuItem Header="Fast Forward _Speed">
                    <MenuItem x:Name="FastForward2xMenu" Header="_2x" Tag="2" IsCheckable="True" Click="OnFastForwardSpeedClick" />
                    <MenuItem x:Name="FastForward3xMenu" Header="_3x" Tag="3" IsCheckable="True" Click="OnFastForwardSpeedClick" />
                    <MenuItem x:Name="FastForward4xMenu" Header="_4x" Tag="4" IsCheckable="True" Click="OnFastForwardSpeedClick" />
                    <MenuItem x:Name="FastForward5xMenu" Header="_5x" Tag="5" IsCheckable="True" Click="OnFastForwardSpeedClick" />
                    <MenuItem x:Name="FastForward6xMenu" Header="_6x" Tag="6" IsCheckable="True" Click="OnFastForwardSpeedClick" />
                    <MenuItem x:Name="FastForward7xMenu" Header="_7x" Tag="7" IsCheckable="True" Click="OnFastForwardSpeedClick" />
                    <MenuItem x:Name="FastForward8xMenu" Header="_8x" Tag="8" IsCheckable="True" Click="OnFastForwardSpeedClick" />
                    <MenuItem x:Name="FastForward9xMenu" Header="_9x" Tag="9" IsCheckable="True" Click="OnFastForwardSpeedClick" />
                    <MenuItem x:Name="FastForward10xMenu" Header="1_0x" Tag="10" IsCheckable="True" Click="OnFastForwardSpeedClick" />
                </MenuItem>
                <Separator />
                <MenuItem Header="E_xit" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Model">
                <MenuItem x:Name="Model16KMenu" Header="Spectrum 16K" Tag="Spectrum16K" IsCheckable="True" Click="OnModelMenuClick" />
