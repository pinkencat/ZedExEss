            <MenuItem Header="_File">
                <MenuItem Header="_Open..." Click="OnOpenFile" />
                <MenuItem Header="_Save Snapshot..." Click="OnSaveSnapshot" />
                <Separator />
                <MenuItem Header="_Reset" Click="OnResetMachine" />
