<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ZedExEss.AvaloniaHost.BasicProgramWindow"
        Title="BASIC Program"
        Width="800"
        Height="580"
        MinWidth="540"
        MinHeight="380"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="12" RowDefinitions="Auto,Auto,*">
    <TextBlock x:Name="StatusText"
               Grid.Row="0" Margin="0,0,0,8"
               TextWrapping="Wrap" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <Button x:Name="InjectButton" Width="90" Content="Inject" />
      <Button x:Name="ReloadButton" Width="150" Content="Reload From Memory" />
      <Button x:Name="CloseButton" Width="90" Content="Close" />
    </StackPanel>
    <TextBox x:Name="BasicInput"
             Grid.Row="2"
             AcceptsReturn="True"
             AcceptsTab="True"
             FontFamily="Consolas,Menlo,Monospace"
             FontSize="14"
             TextWrapping="NoWrap"
             ScrollViewer.HorizontalScrollBarVisibility="Auto"
             ScrollViewer.VerticalScrollBarVisibility="Auto" />
  </Grid>
</Window>
