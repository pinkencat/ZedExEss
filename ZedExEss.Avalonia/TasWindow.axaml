<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ZedExEss.AvaloniaHost.TasWindow"
        Title="TAS" Width="330" Height="380"
        MinWidth="300" MinHeight="330"
        Background="#141414"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="Button.transport">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.slot">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="Foreground" Value="#8AA9CC" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
  </Window.Styles>
  <Grid Margin="10" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*">
    <TextBlock Grid.Row="0" x:Name="FrameText" Text="Frame 0"
               Foreground="White" FontSize="22" FontWeight="SemiBold" />
    <TextBlock Grid.Row="1" x:Name="RecordingText" Text="Not recording"
               Foreground="#B8D7FF" FontSize="12" Margin="0,2,0,0" />

    <TextBlock Grid.Row="2" Classes="section" Text="TRANSPORT" />
    <StackPanel Grid.Row="3" Orientation="Horizontal">
      <Button x:Name="BackTenthButton" Classes="transport" Content="&#x25C0;&#x25C0;"
              ToolTip.Tip="Back a tenth of a second (F7)" />
      <Button x:Name="BackFrameButton" Classes="transport" Content="&#x25C0;"
              ToolTip.Tip="Back one frame (Shift+F8)" />
      <Button x:Name="AdvanceButton" Classes="transport" Content="&#x25B6;"
              ToolTip.Tip="Advance one frame (F8)" />
      <Button x:Name="PauseButton" Classes="transport" Content="&#x23F8;"
              ToolTip.Tip="Pause or resume" />
      <Button x:Name="RecordButton" Classes="transport" Content="&#x25CF;" Foreground="#FF6B6B"
              ToolTip.Tip="Start or stop recording input" />
    </StackPanel>

    <TextBlock Grid.Row="4" Classes="section" Text="STATES" />
    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,3">
      <TextBlock Text="Save" Width="36" Foreground="#AAAAAA" FontSize="11"
                 VerticalAlignment="Center" />
      <StackPanel x:Name="SaveSlotPanel" Orientation="Horizontal" />
    </StackPanel>
    <StackPanel Grid.Row="6" Orientation="Horizontal">
      <TextBlock Text="Load" Width="36" Foreground="#AAAAAA" FontSize="11"
                 VerticalAlignment="Center" />
      <StackPanel x:Name="LoadSlotPanel" Orientation="Horizontal" />
    </StackPanel>

    <TextBlock Grid.Row="7" Classes="section" Text="HISTORY" />
    <StackPanel Grid.Row="8">
      <ProgressBar x:Name="HistoryBar" Height="8" Minimum="0" Maximum="1"
                   Background="#202020" Foreground="#4C9A4C" />
      <TextBlock x:Name="HistoryText" Text="No history yet"
                 Foreground="#AAAAAA" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
        <TextBlock Text="Limit" Width="36" Foreground="#AAAAAA" FontSize="11"
                   VerticalAlignment="Center" />
        <ComboBox x:Name="BudgetCombo" Width="100" Height="24" FontSize="11"
                  ToolTip.Tip="How much memory the rollback history may use" />
      </StackPanel>
      <TextBlock x:Name="HintText" Foreground="#666666" FontSize="10" Margin="0,10,0,0"
                 TextWrapping="Wrap"
                 Text="Ctrl+digit loads a state, Ctrl+Shift+digit saves one. The same keys work in the main window." />
    </StackPanel>
  </Grid>
</Window>
